{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 40,

    // Layout configuration placement blocks
    "modules-left": [
        "hyprland/workspaces",
        "custom/weather",
        "custom/spacer",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/volume",
        "battery",
        "network",
        "cpu",
        "memory"
    ],

    // LEFT GROUP WORKSPACES
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate"
    },

    // NATIVE MPRIS MEDIA COMPONENT
    "mpris": {
        "format": "🎵 {artist} - {title}",
        "format-paused": "⏸️ {artist} - {title}",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // CENTER LAYER CLOCK
    "clock": {
        "format": "{:%a, %b %d  %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "librewolf --app https://calendar.google.com"
    },

    // RIGHT COMPONENT MODULES
    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰖪 Off",
        "on-click": "networkmanager_dmenu"
    },

    "cpu": {
        "interval": 10,
        "format": "  {usage}%",
        "on-click": "foot -e btop"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G",
        "on-click": "foot -e htop"
    },

    "battery": {
        "bat": "ADP1",
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {icon} {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "",
        "interval": 1800,
        "format": "{}"
    },
    "custom/spacer": {
        "format": "    ", // Adjust the number of spaces here to your liking
        "interval": "once",
        "tooltip": false
    }
}
